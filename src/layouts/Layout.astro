---
import '@fontsource-variable/schibsted-grotesk';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'Peter Sormunen | Senior Full-Stack Developer',
	description = 'Portfolio of Peter Sormunen, a full-stack developer in Espoo, Finland.',
	image = '/og-image.png',
} = Astro.props as Props;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#ffffff" />
		<script is:inline>
			(function () {
				var root = document.documentElement;
				root.classList.add('js');
				if (matchMedia('(prefers-reduced-motion: no-preference)').matches) root.classList.add('fade');
				try {
					if (localStorage.getItem('theme') === 'dark') {
						root.setAttribute('data-theme', 'dark');
						document.querySelector('meta[name="theme-color"]').setAttribute('content', '#0c0c0c');
					}
				} catch (e) {}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="robots" content="noindex, nofollow, noarchive, noimageindex" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
	</body>
</html>

<style>
	:global(:root) {
		color-scheme: light;
		--bg: #ffffff;
		--ground: var(--bg);
		--bg-alt: #f1f1ef;
		--text: #0e0e0e;
		--muted: #525250;
		--line: #e4e4e1;
		--line-strong: #cdcdc9;
		--accent: #c42f17;
		--accent-soft: #fbe9e5;
		--on-accent: #ffffff;
		--contact-bg: #0e0e0e;
		--radius-sm: 8px;
		--radius-md: 12px;
		--content-width: 1120px;
		--nav-height: 4rem;
		--sans: 'Schibsted Grotesk Variable', 'Helvetica Neue', Arial, sans-serif;
		--ease-out: cubic-bezier(0.16, 1, 0.3, 1);
		--transition-base: 0.2s var(--ease-out);
		--transition-ground: 0.5s var(--ease-out);
		--z-overlay: 100;
		--z-modal: 200;
	}

	:global(html[data-theme="dark"]) {
		color-scheme: dark;
		--bg: #0c0c0c;
		--ground: var(--bg);
		--bg-alt: #171716;
		--text: #ededeb;
		--muted: #adadaa;
		--line: #2a2a28;
		--line-strong: #42423f;
		--accent: #ff7a5c;
		--accent-soft: #2c1a15;
		--on-accent: #0c0c0c;
		--contact-bg: #000000;
	}

	:global(html) {
		min-height: 100%;
		background: var(--bg);
		scroll-padding-top: calc(var(--nav-height) + 1.5rem);
		scrollbar-color: var(--line-strong) var(--bg);
	}

	@media (prefers-reduced-motion: no-preference) {
		:global(html) {
			scroll-behavior: smooth;
		}
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
		font-family: var(--sans);
		line-height: 1.6;
		color: var(--text);
		background: var(--ground);
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	/* The page ground fades between white and grey as tone sections reach mid-screen. */
	:global(body.toned) {
		--ground: var(--bg-alt);
	}

	:global(html.fade body) {
		transition: background-color var(--transition-ground);
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(a) {
		color: inherit;
		text-underline-offset: 0.2em;
		text-decoration-thickness: 1px;
	}

	:global(:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 4px;
	}

	:global(::selection) {
		background: var(--accent);
		color: var(--on-accent);
	}

	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: var(--z-modal);
		padding: 0.6rem 1rem;
		border-radius: var(--radius-sm);
		background: var(--text);
		color: var(--bg);
		font-weight: 700;
		text-decoration: none;
		transform: translateY(-200%);
	}

	.skip-link:focus {
		transform: none;
	}

	@media (max-height: 480px) {
		:global(html) {
			scroll-padding-top: 1rem;
		}
	}

	@media print {
		:global(body) {
			--ground: #ffffff;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(*),
		:global(*::before),
		:global(*::after) {
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
		}
	}
</style>
