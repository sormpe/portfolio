---

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'Peter Sormunen | Senior Full-Stack Developer',
	description = 'Portfolio of Peter Sormunen, a full-stack developer in Espoo, Finland.',
	image = '/og-image.png',
} = Astro.props as Props;
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			(function () {
				var root = document.documentElement;
				root.classList.add('js');
				try {
					if (localStorage.getItem('theme') === 'dark') root.setAttribute('data-theme', 'dark');
				} catch (e) {}
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="robots" content="noindex, nofollow, noarchive, noimageindex" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
	</body>
</html>

<style>
	:global(:root) {
		color-scheme: light;
		--bg: #ffffff;
		--bg-alt: #f6f5f2;
		--surface: #ffffff;
		--surface-strong: #ffffff;
		--text: #111827;
		--muted: #4b5563;
		--line: #e5e3de;
		--line-strong: #d4d1ca;
		--accent: #8a4b2a;
		--accent-strong: #6f3a1f;
		--accent-soft: #f6ede7;
		--shadow: 0 1px 2px rgba(17, 24, 39, 0.04), 0 8px 24px rgba(17, 24, 39, 0.05);
		--shadow-strong: 0 2px 4px rgba(17, 24, 39, 0.05), 0 16px 40px rgba(17, 24, 39, 0.08);
		--radius-xl: 24px;
		--radius-lg: 16px;
		--radius-md: 12px;
		--content-width: 1120px;
		--nav-height: 4rem;
		--sans: 'Manrope', 'Avenir Next', 'Segoe UI', sans-serif;

		--space-1: 0.25rem;
		--space-2: 0.5rem;
		--space-3: 0.75rem;
		--space-4: 1rem;
		--space-5: 1.25rem;
		--space-6: 1.5rem;
		--space-8: 2rem;
		--space-10: 2.5rem;
		--space-12: 3rem;
		--space-16: 4rem;

		--transition-fast: 0.15s ease;
		--transition-base: 0.2s ease;
		--transition-slow: 0.35s ease;

		--z-base: 0;
		--z-raised: 10;
		--z-overlay: 100;
		--z-modal: 200;
	}

	:global(html[data-theme="dark"]) {
		color-scheme: dark;
		--bg: #12110e;
		--bg-alt: #1a1915;
		--surface: #1c1b17;
		--surface-strong: #22201b;
		--text: #f1ede4;
		--muted: #b3ab9c;
		--line: #2e2c26;
		--line-strong: #403d35;
		--accent: #e0995a;
		--accent-strong: #f0b07a;
		--accent-soft: #2a2119;
		--shadow: none;
		--shadow-strong: 0 16px 40px rgba(0, 0, 0, 0.45);
	}

	:global(html) {
		min-height: 100%;
		background: var(--bg);
		scroll-padding-top: calc(var(--nav-height) + 1rem);
	}

	@media (prefers-reduced-motion: no-preference) {
		:global(html) {
			scroll-behavior: smooth;
		}
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
		font-family: var(--sans);
		color: var(--text);
		background: var(--bg);
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
		transition: background var(--transition-slow), color var(--transition-slow);
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(a) {
		color: inherit;
	}

	:global(:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 4px;
	}

	:global(::selection) {
		background: color-mix(in srgb, var(--accent) 22%, transparent);
	}

	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: var(--z-modal);
		padding: 0.6rem 1rem;
		border-radius: 999px;
		background: var(--text);
		color: var(--bg);
		font-weight: 700;
		text-decoration: none;
		transform: translateY(-200%);
	}

	.skip-link:focus {
		transform: none;
	}

	:global(.u-card) {
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface);
	}

	:global(.u-eyebrow) {
		margin: 0 0 0.85rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
	}

	@media (prefers-reduced-motion: reduce) {
		:global(*),
		:global(*::before),
		:global(*::after) {
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
		}
	}
</style>
