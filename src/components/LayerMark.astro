---
interface Props {
	layer: string;
}

// One plain shape per layer: a browser window, a server stack and a cloud.
const shapes: Record<string, string> = {
	frontend:
		'M4 3h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 5v11h16V8zm1.5-3.25a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm3 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2zM6 10h7v2H6zm0 3.5h12v4H6z',
	backend:
		'M4 2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm0 12h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2zM6 5v2h2V5zm4 0v2h2V5zM6 17v2h2v-2zm4 0v2h2v-2z',
	cloud: 'M6.5 19.5a5 5 0 0 1-.9-9.92 6.5 6.5 0 0 1 12.36-1.4A5.5 5.5 0 0 1 17.5 19.5z',
};

const shape = shapes[Astro.props.layer];
---

{shape && (
	<div class="layer-mark" aria-hidden="true">
		<svg viewBox="0 0 24 24"><path fill-rule="evenodd" d={shape} /></svg>
	</div>
)}

<style>
	/* Fills the empty rail under the layer name; there is no rail on narrow screens. */
	.layer-mark {
		display: none;
	}

	@media (min-width: 861px) {
		.layer-mark {
			display: block;
			width: clamp(7rem, 11vw, 10rem);
			margin-top: clamp(2rem, 4vw, 3.5rem);
			color: var(--text);
			opacity: 0.06;
			will-change: transform;
		}

		:global(html[data-theme='dark']) .layer-mark {
			opacity: 0.08;
		}
	}

	svg {
		display: block;
		width: 100%;
		height: auto;
		fill: currentColor;
	}

	@media print {
		.layer-mark {
			display: none;
		}
	}
</style>
