---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Nav from '../components/Nav.astro';
import LayerMark from '../components/LayerMark.astro';
import LogoField from '../components/LogoField.astro';
import StackBand from '../components/StackBand.astro';
import profile from '../assets/profile.jpg';
import { education, experience, layers, projects, skills, site, spokenLanguages } from '../data/site';
import { logoPaths } from '../data/stack';

const emailHref = `mailto:${site.email}`;
const layerName = (id: string) => layers.find((layer) => layer.id === id)?.name;
const projectById = (id: string) => projects.find((project) => project.id === id)!;
// The contact row starts mid-list so it doesn't repeat the hero's opening logos.
const contactLogos = [...logoPaths.slice(5), ...logoPaths.slice(0, 5)];
const firstLayer = (project: (typeof projects)[number]) => layers.find((layer) => project.work[layer.id])!;
---

<Layout title={`${site.name} | ${site.title}`} description={site.description}>
	<Nav />
	<main class="page" id="main" tabindex="-1">
		<section class="hero" id="top" aria-labelledby="hero-title">
			<p class="hero__identity"><strong>{site.name}</strong> <span>{site.title}</span></p>
			<h1 id="hero-title">{site.statement}</h1>
			<div class="hero__next">
				<p class="hero__availability">{site.availability}. Based in {site.location}.</p>
				<div class="actions">
					<a class="button button--primary" href={emailHref}>Email me</a>
					<a class="button button--secondary" href="#work">See the work</a>
				</div>
			</div>
			<Picture
				class="hero__portrait"
				pictureAttributes={{ class: 'hero__picture' }}
				src={profile}
				formats={['avif', 'webp']}
				widths={[192, 360, 640]}
				sizes="(max-width: 760px) 72px, 224px"
				alt={`Portrait of ${site.name}`}
				loading="eager"
			/>
		</section>

		<StackBand />

		<section class="section" id="work">
			<SectionHeading
				title="Work"
				description="Recent client, internal, and research projects. Client names are left out."
			/>
			<div class="work-switch" role="group" aria-label="Sort work">
				<button type="button" data-work-view="layers" aria-pressed="true">By layer</button>
				<button type="button" data-work-view="date" aria-pressed="false">By date</button>
			</div>
			<div id="work-layers">
			{layers.map((layer) => (
				<section class="layer" id={layer.id} aria-labelledby={`${layer.id}-title`}>
					<header class="layer__header">
						<h3 id={`${layer.id}-title`}>{layer.name}</h3>
						<p>{layer.intro}</p>
						<LayerMark layer={layer.id} />
					</header>
					<div class="layer__entries">
						{layer.order.map(projectById).map((project) => {
							const touched = Object.keys(project.work);
							const others = touched.filter((id) => id !== layer.id);
							const isFirst = layers.find((l) => project.work[l.id])?.id === layer.id;
							return (
								<article class:list={['entry', { 'entry--lead': isFirst && touched.length === 3 }]} id={`${layer.id}-${project.id}`}>
									<h4>{project.name}</h4>
									{isFirst && (
										<>
											<p class="entry__meta">
												{project.category} · {project.years} · {project.role}{touched.length === 3 && ' · Spans all three layers'}
											</p>
											<p class="entry__summary">{project.summary}</p>
										</>
									)}
									<ul class="entry__work">
										{project.work[layer.id]?.map((line) => <li>{line}</li>)}
									</ul>
									<p class="entry__foot">
										{isFirst && (
											<span>
												<span class="visually-hidden">Technologies: </span>{project.stack.join(' · ')}
											</span>
										)}
										<span class="entry__also">
											Also under {others.map((id, index) => (
												<>
													{index > 0 && ' and '}
													<a href={`#${id}-${project.id}`}>{layerName(id)}</a>
												</>
											))}
										</span>
									</p>
								</article>
							);
						})}
					</div>
				</section>
			))}
			</div>
			<ol class="work-date" id="work-date" hidden>
				{projects.map((project) => (
					<li class="date-row" id={`date-${project.id}`}>
						<p class="row__period">{project.years}</p>
						<div class="entry">
							<h3>{project.name}</h3>
							<p class="entry__meta">{project.category} · {project.role}</p>
							<p class="entry__summary">{project.summary}</p>
							{layers.filter((layer) => project.work[layer.id]).map((layer) => (
								<>
									<h4 class="date-row__layer">{layer.name}</h4>
									<ul class="entry__work">
										{project.work[layer.id]?.map((line) => <li>{line}</li>)}
									</ul>
								</>
							))}
							<p class="entry__foot">
								<span>
									<span class="visually-hidden">Technologies: </span>{project.stack.join(' · ')}
								</span>
							</p>
						</div>
					</li>
				))}
			</ol>
			<aside class="work-cta" aria-label="Get in touch">
				<p>Sounds like the kind of work you need done?</p>
				<a class="button button--primary" href={emailHref}>Email me</a>
			</aside>
		</section>

		<section class="section section--tone" id="experience">
			<SectionHeading
				title="Experience"
				description="Ten years across a product company, a university, and consulting."
			/>
			<ol class="rows">
				{experience.map((item) => (
					<li class="row">
						<p class="row__period">{item.period}</p>
						<div>
							<h3>{item.company}</h3>
							<p class="row__title">{item.title}</p>
							<p class="row__summary">{item.summary}</p>
							{item.projects.length > 0 && (
								<ul class="row__projects" aria-label={`Projects at ${item.company}`}>
									{item.projects.map(projectById).map((project) => (
										<li>
											<a href={`#${firstLayer(project).id}-${project.id}`}>
												<span class="row__project-years">{project.years}</span>
												<span class="row__project-name">{project.name}</span>
											</a>
										</li>
									))}
								</ul>
							)}
						</div>
					</li>
				))}
			</ol>
		</section>

		<section class="section about" id="about">
			<SectionHeading title="About" />
			<div class="about__copy">
				<p>
					I build and improve web applications, from new projects to products already in use. I
					contribute to technical decisions and carry features through implementation, testing, and
					release.
				</p>
				<p>
					I work closely with product, design, and engineering, and have also facilitated Scrum. AI
					tools are part of my workflow; I use them as support and remain accountable for the code and
					the decisions behind it.
				</p>
			</div>
		</section>

		<section class="section section--tone" id="background">
			<SectionHeading title="Skills and education" />
			<div class="reference">
				<div>
					<h3>Skills I’ve used in production</h3>
					<dl class="reference__list">
						{skills.map((group) => (
							<div>
								<dt>{group.group}</dt>
								<dd>{group.items.join(', ')}</dd>
							</div>
						))}
					</dl>
				</div>
				<div class="reference__side">
					<div>
						<h3>Education</h3>
						<dl class="reference__list reference__list--stacked">
							{education.map((entry) => (
								<div>
									<dt>{entry.degree}</dt>
									<dd>{entry.school}, <span class="nowrap">{entry.period}</span></dd>
								</div>
							))}
						</dl>
					</div>
					<div>
						<h3>Spoken languages</h3>
						<p class="reference__text">{spokenLanguages.join(', ')}</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section contact" id="contact">
			<div class="contact-field" aria-hidden="true">
				{[...contactLogos, ...contactLogos].map((path) => (
					<svg viewBox="0 0 24 24"><path d={path} /></svg>
				))}
			</div>
			<SectionHeading
				title="Get in touch"
				description="Email me about consulting engagements, roles, or anything you’re building. A short note is fine."
			/>
			<div class="actions contact__actions">
				<a class="button button--primary" href={emailHref}>Email me</a>
				<a class="button button--secondary" href={site.linkedin}>LinkedIn</a>
				<a class="button button--secondary" href={site.github}>GitHub</a>
			</div>
			<dl class="contact-meta">
				<div>
					<dt>Email</dt>
					<dd><a href={emailHref}>{site.email}</a></dd>
				</div>
				<div>
					<dt>Based in</dt>
					<dd>{site.location}, {site.timezone}</dd>
				</div>
				<div>
					<dt>Availability</dt>
					<dd>{site.availability}</dd>
				</div>
			</dl>
		</section>
	</main>
	<LogoField />
</Layout>

<script is:inline>
	(function () {
		var buttons = document.querySelectorAll('[data-work-view]');
		var views = { layers: document.getElementById('work-layers'), date: document.getElementById('work-date') };

		function show(view) {
			views.layers.hidden = view !== 'layers';
			views.date.hidden = view !== 'date';
			buttons.forEach(function (b) {
				b.setAttribute('aria-pressed', String(b.dataset.workView === view));
			});
		}

		buttons.forEach(function (b) {
			b.addEventListener('click', function () { show(b.dataset.workView); });
		});

		// A link to the hash already in the URL fires no hashchange, so clicks reveal the layer view too.
		document.addEventListener('click', function (e) {
			var link = e.target.closest && e.target.closest('a[href^="#"]');
			var target = link && document.getElementById(link.getAttribute('href').slice(1));
			if (target && views.layers.contains(target) && views.layers.hidden) show('layers');
		});

		// Layer links can arrive while the date view is showing, so reveal their target first.
		function revealTarget() {
			var target = location.hash && document.getElementById(location.hash.slice(1));
			if (target && views.layers.contains(target) && views.layers.hidden) {
				show('layers');
				target.scrollIntoView();
			}
		}
		window.addEventListener('hashchange', revealTarget);

		// Without the fade, tone sections stay as sharp bands and the ground never changes.
		if (!document.documentElement.classList.contains('fade')) return;

		// Contact counts as toned so the grey holds behind the Skills section above it.
		var toned = new Set();
		var observer = new IntersectionObserver(function (entries) {
			entries.forEach(function (entry) {
				if (entry.isIntersecting) toned.add(entry.target);
				else toned.delete(entry.target);
			});
			document.body.classList.toggle('toned', toned.size > 0);
		}, { rootMargin: '-50% 0px -50% 0px' });

		document.querySelectorAll('.section--tone, #contact').forEach(function (section) {
			observer.observe(section);
		});

		// Layer marks tilt as their layer passes, and the contact logos drift sideways.
		var marks = document.querySelectorAll('.layer-mark');
		var contact = document.getElementById('contact');
		var contactField = contact.querySelector('.contact-field');
		var ticking = false;

		function drift() {
			ticking = false;
			var height = window.innerHeight;
			marks.forEach(function (mark) {
				var rect = mark.closest('.layer').getBoundingClientRect();
				if (rect.bottom < 0 || rect.top > height) return;
				var progress = (height - rect.top) / (height + rect.height) - 0.5;
				mark.style.transform = 'translate3d(0, ' + (progress * -40).toFixed(1) + 'px, 0) rotate(' + (progress * 14).toFixed(1) + 'deg)';
			});
			var top = contact.getBoundingClientRect().top;
			if (top < height) contactField.style.transform = 'translate3d(' + (-200 - (height - top) * 0.25).toFixed(1) + 'px, 0, 0)';
		}

		window.addEventListener('scroll', function () {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(drift);
			}
		}, { passive: true });
		window.addEventListener('resize', drift);
		drift();
	})();
</script>

<style>
	/* Above the fixed logo field. */
	.page {
		position: relative;
		z-index: 1;
		padding-top: clamp(2.5rem, 6vw, 5rem);
	}

	.page > section {
		width: min(calc(100% - 2rem), var(--content-width));
		margin-inline: auto;
	}

	.page:focus {
		outline: none;
	}

	.nowrap {
		white-space: nowrap;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	/* Hero */

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 14rem;
		grid-template-areas:
			'identity portrait'
			'statement portrait'
			'next next';
		gap: 0 clamp(2.5rem, 6vw, 5rem);
	}

	.hero__identity {
		grid-area: identity;
		margin: 0 0 1.5rem;
		font-size: 1.1rem;
		line-height: 1.35;
	}

	.hero__identity strong {
		font-weight: 800;
	}

	.hero__identity span {
		color: var(--muted);
	}

	h1 {
		grid-area: statement;
		margin: 0;
		font-size: clamp(2.4rem, 5.4vw, 4.5rem);
		font-weight: 800;
		line-height: 1.03;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.hero__next {
		grid-area: next;
	}

	.hero__availability {
		margin: 1.75rem 0 0;
		font-size: 1.15rem;
		color: var(--muted);
		text-wrap: pretty;
	}

	/* The portrait fills the identity and statement rows, so its bottom edge meets the statement's. */
	.hero :global(.hero__picture) {
		grid-area: portrait;
		position: relative;
	}

	.hero :global(.hero__portrait) {
		display: block;
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 20%;
		border-radius: var(--radius-md);
		outline: 1px solid var(--line);
		outline-offset: -1px;
		background: var(--bg-alt);
	}

	/* Buttons */

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		padding: 0.5rem 1.4rem;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		font-weight: 700;
		text-decoration: none;
		transition: background var(--transition-base), border-color var(--transition-base), transform var(--transition-base);
	}

	.button:active {
		transform: translateY(1px);
	}

	.button--primary {
		background: var(--text);
		color: var(--bg);
	}


	.button--secondary {
		border-color: var(--line-strong);
		color: var(--text);
	}

	@media (hover: hover) {
		.button--primary:hover {
			background: var(--accent);
			color: var(--on-accent);
		}

		.button--secondary:hover {
			border-color: var(--accent);
			color: var(--accent);
		}

		.entry__also a:hover,
		.row__projects a:hover .row__project-name,
		.contact-meta a:hover {
			color: var(--accent);
		}

		.work-switch button:not([aria-pressed="true"]):hover {
			color: var(--text);
		}
	}

	/* Sections */

	.section {
		padding-top: clamp(4.5rem, 10vw, 8rem);
	}

	/* Tone sections shift the page's ground, so the background changes as the visitor scrolls. */

	.page > .section--tone {
		--line: var(--line-strong);
		width: 100%;
		margin-top: clamp(4.5rem, 10vw, 8rem);
		padding: clamp(4rem, 8vw, 6.5rem) max(1rem, calc((100% - var(--content-width)) / 2));
		background: var(--bg-alt);
	}

	/* With the fade on, the page ground carries the tone instead. Without it these stay sharp bands. */
	:global(html.fade) .page > .section--tone {
		margin-top: 0;
		background: transparent;
	}

	/* No band to pad out, and the next section brings its own space. */
	:global(html.fade) .page > #experience {
		padding-bottom: 0;
	}

	/* Work */

	.work-switch {
		display: inline-flex;
		gap: 0.25rem;
		margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
		padding: 0.25rem;
		border-radius: var(--radius-md);
		background: var(--bg-alt);
	}

	:global(html:not(.js)) .work-switch {
		display: none;
	}

	.work-switch button {
		min-height: 2.75rem;
		padding: 0 1.1rem;
		border: 0;
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--muted);
		font: inherit;
		font-size: 0.95rem;
		font-weight: 700;
		cursor: pointer;
		transition: background var(--transition-base), color var(--transition-base);
	}

	.work-switch button[aria-pressed="true"] {
		background: var(--text);
		color: var(--bg);
	}

	.work-date {
		margin: 0 0 clamp(1.75rem, 4vw, 3rem);
		padding: 0;
		list-style: none;
	}

	.date-row {
		display: grid;
		grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.6fr);
		gap: 0.25rem clamp(2rem, 5vw, 4rem);
		padding: clamp(1.75rem, 4vw, 2.5rem) 0;
		border-top: 1px solid var(--line-strong);
	}

	.date-row h3 {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: -0.015em;
	}

	.entry .date-row__layer {
		margin: 1.25rem 0 0;
		font-size: 0.95rem;
		letter-spacing: 0;
	}

	.date-row__layer + .entry__work {
		margin-top: 0.35rem;
	}

	.layer {
		display: grid;
		grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.6fr);
		gap: 1.25rem clamp(2rem, 5vw, 4rem);
		padding: clamp(1.75rem, 4vw, 3rem) 0;
		border-top: 1px solid var(--line-strong);
	}

	.layer__header {
		position: sticky;
		top: calc(var(--nav-height) + 1.5rem);
		align-self: start;
	}

	.layer__header h3 {
		margin: 0;
		font-size: clamp(1.5rem, 2.4vw, 1.9rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.025em;
	}

	.layer__header p {
		margin: 0.5rem 0 0;
		color: var(--muted);
		text-wrap: pretty;
	}

	.layer__entries {
		display: grid;
		gap: clamp(2rem, 4vw, 2.75rem);
		min-width: 0;
	}

	.entry {
		border-radius: 2px;
	}

	.entry h4 {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: -0.015em;
	}

	.entry--lead h4 {
		font-size: clamp(1.4rem, 2.2vw, 1.65rem);
		letter-spacing: -0.025em;
	}

	.entry__meta {
		margin: 0.3rem 0 0;
		font-size: 0.92rem;
		font-weight: 500;
		color: var(--muted);
	}

	.entry__summary {
		margin: 0.75rem 0 0;
		font-size: 1.05rem;
		text-wrap: pretty;
	}

	.entry__work {
		display: grid;
		gap: 0.4rem;
		max-width: 40rem;
		margin: 0.75rem 0 0;
		padding-left: 1.1rem;
		list-style: disc;
		color: var(--muted);
		text-wrap: pretty;
	}

	.entry__work li::marker {
		color: var(--accent);
	}

	.entry__foot {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 0.75rem 0 0;
		font-size: 0.92rem;
		font-weight: 500;
		color: var(--muted);
	}

	.entry__also a {
		display: inline-block;
		font-weight: 700;
		color: var(--text);
	}

	/* Arriving from a link in another layer lights the same project once. */
	.entry:target {
		background: var(--accent-soft);
		box-shadow: 0 0 0 0.6rem var(--accent-soft);
	}

	@media (prefers-reduced-motion: no-preference) {
		.entry:target {
			background: transparent;
			box-shadow: 0 0 0 0.6rem transparent;
			animation: entry-arrive 2.2s var(--ease-out);
		}

		@keyframes entry-arrive {
			/* Hold the tint while a long smooth scroll is still landing. */
			from,
			38% {
				background: var(--accent-soft);
				box-shadow: 0 0 0 0.6rem var(--accent-soft);
			}

			to {
				background: transparent;
				box-shadow: 0 0 0 0.6rem transparent;
			}
		}
	}

	.work-cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		padding: 1.5rem 0;
		border-top: 1px solid var(--line-strong);
		border-bottom: 1px solid var(--line-strong);
	}

	.work-cta p {
		margin: 0;
		font-size: clamp(1.15rem, 2vw, 1.4rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		text-wrap: balance;
	}

	/* Experience */

	.rows {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.row {
		display: grid;
		grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.6fr);
		gap: 0.25rem clamp(2rem, 5vw, 4rem);
		padding: 1.75rem 0;
		border-top: 1px solid var(--line);
	}

	.row__period {
		margin: 0;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: var(--muted);
	}

	.row h3 {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 800;
		line-height: 1.3;
